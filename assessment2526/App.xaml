<?xml version="1.0" encoding="utf-8" ?>
<Application
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    x:Class="assessment2526.App">

    <Application.Resources>
        <ResourceDictionary>

            <!-- Dynamic font sizes. These values are updated from the Settings page when the user turns large text mode on or off. -->
            <x:Double x:Key="TitleFontSize">24</x:Double>
            <x:Double x:Key="SectionFontSize">18</x:Double>
            <x:Double x:Key="BodyFontSize">14</x:Double>
            <x:Double x:Key="SmallFontSize">13</x:Double>
            <x:Double x:Key="ButtonFontSize">14</x:Double>

        </ResourceDictionary>
    </Application.Resources>
</Application>