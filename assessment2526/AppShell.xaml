<?xml version="1.0" encoding="UTF-8" ?>
<Shell
    x:Class="assessment2526.AppShell"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:local="clr-namespace:assessment2526"
    Shell.FlyoutBehavior="Disabled">

    <TabBar>
        <ShellContent
            Title="Home"
            Icon="homepage.png"
            Route="HomePage"
            ContentTemplate="{DataTemplate local:MainPage}" />

        <ShellContent
            Title="New Task"
            Icon="plus.png"
            Route="NewTask"
            ContentTemplate="{DataTemplate local:NewTask}" />

        <ShellContent
            Title="Settings"
            Icon="settings.png"
            Route="Settings"
            ContentTemplate="{DataTemplate local:Settings}" />
    </TabBar>

</Shell>